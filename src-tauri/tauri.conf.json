{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Meetly Lite",
  "version": "0.1.0",
  "identifier": "com.meetly.lite",
  "build": {
    "beforeDevCommand": "npm run prepare:ffmpeg && npm run dev",
    "beforeBuildCommand": "npm run prepare:ffmpeg && npm run build",
    "devUrl": "http://127.0.0.1:3118",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Meetly Lite",
        "width": 1040,
        "height": 760,
        "minWidth": 960,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "theme": "Light"
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/icon.ico"],
    "resources": {
      "resources/": "resources/"
    }
  }
}