{
  "name": "meetly-lite",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3118 --strictPort",
    "prepare:ffmpeg": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-ffmpeg.ps1",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "node scripts/stage-foundry-native.mjs && tauri build",
    "test:foundry-native-stage": "node --test scripts/stage-foundry-native.test.mjs",
    "test:audio": "node --test src/audio/*.test.mjs",
    "test:assistant": "node --test src/assistant/*.test.mjs",
    "build": "tsc && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4118"
  },
  "dependencies": {
    "@tauri-apps/api": "latest",
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "microsoft-cognitiveservices-speech-sdk": "^1.51.0",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@tauri-apps/cli": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest"
  }
}
